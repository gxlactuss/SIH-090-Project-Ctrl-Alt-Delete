# Application Settings
PROJECT_NAME="Listing Factory API"
VERSION="0.1.0"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/listing_factory"

# Security / Authentication (Placeholder for future JWT auth)
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"

# Media Storage
MEDIA_STORAGE_DIR="./media"

# CORS Origins (JSON list or comma-separated string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
