# Application Settings
PROJECT_NAME="Listing Factory API"
VERSION="0.1.0"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/listing_factory"

# Security / Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Firebase Authentication (Provide either JSON content or file path; do not commit real secrets)
# Option 1: Inline service account JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Option 2: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=""

# Media Storage
MEDIA_STORAGE_DIR="./media"
MAX_MEDIA_UPLOAD_SIZE=10485760

# Pipeline Configuration
PIPELINE_MAX_STAGE_ATTEMPTS=3

# AI & Speech Service API Keys
SARVAM_API_KEY="key here"
GEMINI_API_KEY="key here"
GEMINI_MODEL="gemini-3.5-flash"

# CORS Origins (JSON list or comma-separated string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
