  "helpTermsEntry": "ನಿಯಮಗಳು ಮತ್ತು ಗೌಪ್ಯತೆ",
  "faqTitle": "ಜನರು ಕೇಳುವ ಪ್ರಶ್ನೆಗಳು",
  "faqQ1": "ಇದಕ್ಕೆ ನಾನು ಏನಾದರೂ ಕೊಡಬೇಕೇ?",
  "faqA1": "ಇಲ್ಲ. ವಸ್ತುಗಳನ್ನು ಇಡುವುದು ಉಚಿತ. ಏನಾದರೂ ಮಾರಾಟವಾದಾಗ ಮಾತ್ರ ಮಾರುಕಟ್ಟೆ ಸಣ್ಣ ಪಾಲು ತೆಗೆದುಕೊಳ್ಳುತ್ತದೆ.",
  "faqQ2": "ನೆಟ್‌ವರ್ಕ್ ಇಲ್ಲದಿದ್ದರೆ?",
  "faqA2": "ಎಲ್ಲವೂ ಕೆಲಸ ಮಾಡುತ್ತಲೇ ಇರುತ್ತದೆ. ನೀವು ಮಾಡಿದ್ದು ನಿಮ್ಮ ಫೋನಿನಲ್ಲಿ ಇರುತ್ತದೆ ಮತ್ತು ನೆಟ್‌ವರ್ಕ್ ಬಂದಾಗ ತಾನಾಗಿಯೇ ಹೋಗುತ್ತದೆ.",
  "faqQ3": "ನನ್ನ ಹಣ ಯಾರಿಗೆ ಹೋಗುತ್ತದೆ?",
  "faqA3": "ನಿಮಗೆ. ಖರೀದಿದಾರರು ಮಾರುಕಟ್ಟೆಯಲ್ಲಿ ಹಣ ಕೊಡುತ್ತಾರೆ ಮತ್ತು ಅದು ನಿಮ್ಮ ಖಾತೆಗೆ ಬರುತ್ತದೆ. ಹಣ ಎಂದಿಗೂ ನಮ್ಮ ಮೂಲಕ ಹೋಗುವುದಿಲ್ಲ.",
  "faqQ4": "ಮಾರಾಟಕ್ಕೆ ಇಟ್ಟ ನಂತರ ಏನಾದರೂ ಬದಲಿಸಬಹುದೇ?",
  "faqA4": "ಹೌದು. ನಿಮ್ಮ ವಸ್ತುಗಳಿಂದ ತೆರೆಯಿರಿ, ಬೇಕಾದ್ದನ್ನು ಬದಲಿಸಿ, ಅದು ಮತ್ತೆ ಮಾರಾಟಕ್ಕೆ ಹೋಗುತ್ತದೆ.",
  "faqQ5": "ನಾನು ಏನಾದರೂ ತಪ್ಪು ಹೇಳಿದರೆ?",
  "faqA5": "ನೀವು ಕೇಳಿ ಸರಿ ಎನ್ನುವವರೆಗೆ ಏನೂ ಮಾರಾಟಕ್ಕೆ ಹೋಗುವುದಿಲ್ಲ. ಮಾತನಾಡಿ ಯಾವುದೇ ಭಾಗವನ್ನು ಸರಿಪಡಿಸಬಹುದು.",
  "faqQ6": "ನನಗೆ ಓದಲು-ಬರೆಯಲು ಬರಬೇಕೇ?",
  "faqA6": "ಇಲ್ಲ. ನೀವು ಎಲ್ಲವನ್ನೂ ಮಾತನಾಡಿ ಮತ್ತು ಒತ್ತಿ ಮಾಡಬಹುದು. ಪ್ರತಿ ಪರದೆಯನ್ನೂ ನಿಮಗೆ ಓದಿ ಹೇಳಬಹುದು.",
  "faqQ7": "ನನ್ನ ಹೆಸರು ಮತ್ತು ಊರು ಯಾರು ನೋಡುತ್ತಾರೆ?",
  "faqA7": "ನೀವು ಅನುಮತಿಸಿದರೆ ಮಾತ್ರ, ಪ್ರತಿ ವಸ್ತುವಿಗೂ ಬೇರೆಯಾಗಿ. ನೀವು ಯಾವಾಗ ಬೇಕಾದರೂ ಹಿಂಪಡೆಯಬಹುದು.",
  "aboutTitle": "ಕೀರ್ತಿಕರ್ ಬಗ್ಗೆ",
  "aboutWhatTitle": "ಇದು ಏನು",
  "aboutWhat": "ಕೀರ್ತಿಕರ್ ಕೈಯಿಂದ ಮಾಡಿದ ವಸ್ತುಗಳನ್ನು ONDC ಗೆ — ಭಾರತದ ಮುಕ್ತ ಖರೀದಿ-ಮಾರಾಟ ಜಾಲಕ್ಕೆ — ತಲುಪಿಸುತ್ತದೆ, ಮತ್ತು ಅದಕ್ಕಾಗಿ ಮಾಡುವವರು ಬರೆಯಬೇಕಿಲ್ಲ, ಮಾತನಾಡಿದರೆ ಸಾಕು. ನಿಮ್ಮದೇ ಭಾಷೆಯಲ್ಲಿ ಕೆಲವು ಫೋಟೋಗಳು ಮತ್ತು ಒಂದು ಧ್ವನಿ ಸಂದೇಶದಿಂದ ದೇಶದಾದ್ಯಂತ ಖರೀದಿದಾರರು ಹುಡುಕಬಹುದಾದ ಪಟ್ಟಿ ತಯಾರಾಗುತ್ತದೆ.",
  "aboutWhyTitle": "ನಾವು ಇದನ್ನು ಏಕೆ ಮಾಡಿದೆವು",
  "aboutWhy": "ಭಾರತದಲ್ಲಿ ಸುಮಾರು ಎಪ್ಪತ್ತು ಲಕ್ಷ ಕುಶಲಕರ್ಮಿಗಳು ಜನರು ಖರೀದಿಸಲು ಬಯಸುವ ವಸ್ತುಗಳನ್ನು ಮಾಡುತ್ತಾರೆ, ಮತ್ತು ಅವರಲ್ಲಿ ಹೆಚ್ಚಿನವರು ಲಾಭದ ವ್ಯತ್ಯಾಸವನ್ನು ಇಟ್ಟುಕೊಳ್ಳುವ ಮಧ್ಯವರ್ತಿಯ ಮೂಲಕ ಮಾರುತ್ತಾರೆ. ಅಡ್ಡಿ ಕೆಲಸದಲ್ಲಿಲ್ಲ. ಅಡ್ಡಿ ಫಾರ್ಮ್‌ನಲ್ಲಿದೆ: ಆನ್‌ಲೈನ್ ಪಟ್ಟಿಗೆ ಇಂಗ್ಲಿಷ್‌ನಲ್ಲಿ ಟೈಪ್ ಮಾಡುವುದು, ಹಲವು ಕಾಲಂಗಳು ಮತ್ತು ಕ್ಯಾಟಲಾಗ್‌ನಂತೆ ತೆಗೆದ ಫೋಟೋ ಬೇಕು. ಈ ಆ್ಯಪ್ ಆ ಫಾರ್ಮ್ ಅನ್ನೇ ತೆಗೆದುಹಾಕುತ್ತದೆ.",
  "aboutHowTitle": "ಇದು ಹೇಗೆ ಕೆಲಸ ಮಾಡುತ್ತದೆ",
  "aboutHow": "ಮೂರು ಫೋಟೋ ತೆಗೆಯಿರಿ ಮತ್ತು ಇದು ಏನು ಎಂದು ಹೇಳಿ. ನಮ್ಮ ವ್ಯವಸ್ಥೆ ಕೇಳುತ್ತದೆ, ಪಟ್ಟಿ ಬರೆಯುತ್ತದೆ, ಮತ್ತು ನಿಮಗೆ ಓದಿ ಹೇಳುತ್ತದೆ. ನೀವು ಕೇಳಿ ಸರಿ ಎನ್ನುವವರೆಗೆ ಏನೂ ಹೊರಗೆ ಹೋಗುವುದಿಲ್ಲ.",
