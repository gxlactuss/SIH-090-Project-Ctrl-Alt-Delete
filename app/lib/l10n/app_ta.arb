  "privacyTitle": "உங்களைப் பற்றி என்ன தெரிகிறது",
  "privacyBody": "ஒவ்வொரு பொருளையும் விற்பனைக்கு வைத்தபோது இவற்றுக்கு ஆம் என்றீர்கள். இவற்றில் எதையும் திரும்பப் பெறலாம்.",
  "privacyPhoto": "இந்தப் பொருளின் படங்கள்",
  "privacyStory": "உங்கள் பெயர், ஊர், கதை",
  "privacyNothing": "இப்போது உங்களுடையது எதுவும் விற்பனையில் இல்லை.",
  "privacyWithdrawTitle": "இதைத் திரும்பப் பெறவா?",
  "privacyWithdrawPhotoBody": "படங்கள் இல்லாமல் இந்தப் பொருள் விற்பனையில் இருக்க முடியாது, அதனால் இறங்கும். எதுவும் அழிக்கப்படாது.",
  "privacyWithdrawStoryBody": "உங்கள் பெயர், ஊர், கதை இந்தப் பொருளிலிருந்து நீக்கப்படும். இது விற்பனையிலேயே இருக்கும்.",
  "privacyWithdrawConfirm": "ஆம், திரும்பப் பெறு",
  "privacyWithdrawCancel": "வேண்டாம், இருக்கட்டும்",
  "privacyWithdrawn": "திரும்பப் பெறப்பட்டது",
  "storageTitle": "இந்த போனில் இடம்",
  "storagePhotos": "படங்களும் பதிவுகளும்",
  "storageWaiting": "{count, plural, =0{அனுப்ப எதுவும் காத்திருக்கவில்லை} =1{1 பொருள் அனுப்பக் காத்திருக்கிறது} other{{count} பொருட்கள் அனுப்பக் காத்திருக்கின்றன}}",
  "storageClear": "அனுப்பப்பட்டவற்றை நீக்கு",
  "storageClearWhy": "இன்னும் அனுப்பக் காத்திருப்பவை ஒருபோதும் தொடப்படாது.",
  "storageCleared": "{size} காலியானது",
  "storageNothingToClear": "நீக்க எதுவும் இல்லை",
  "accountTitle": "வெளியேறு",
  "accountSignOut": "இந்த போனிலிருந்து வெளியேறு",
  "accountSignOutTitle": "வெளியேறவா?",
  "accountSignOutBody": "அனுப்பக் காத்திருப்பவை இழக்கப்படும். விற்பனையில் உள்ளவை விற்பனையிலேயே இருக்கும்.",
  "accountSignOutConfirm": "ஆம், வெளியேறு",
  "accountSignOutCancel": "வேண்டாம், உள்ளேயே இரு",
  "accountDelete": "என் கணக்கை அழி",
  "accountDeleteTitle": "உங்கள் கணக்கை அழிக்கவா?",
  "accountDeleteBody": "எல்லாம் விற்பனையிலிருந்து இறங்கும், இந்த போனில் உள்ள அனைத்தும் அழிக்கப்படும். இதைத் திரும்பப் பெற முடியாது.",
  "accountDeleteConfirm": "ஆம், எல்லாவற்றையும் அழி",
  "accountDeleteCancel": "வேண்டாம், என் கணக்கு இருக்கட்டும்",
  "accountDeleteHold": "அழிக்கப் பொத்தானை அழுத்திப் பிடியுங்கள்",
  "profileHelpEntry": "உதவி",
  "helpTitle": "உதவி",
  "helpBody": "சுருக்கமான பதில்கள், படித்துக் காட்டப்படும். கேட்க எதையாவது அழுத்துங்கள்.",
  "helpSteps": "இப்படிச் செய்யுங்கள்",
  "helpTopicPhotos": "நல்ல படங்கள் எடுப்பது",
  "helpTopicPhotosBody": "நல்ல படங்கள் விற்கும். வாங்குபவர் பொருளைக் கையில் எடுக்க முடியாது, அவரிடம் படம் மட்டுமே உள்ளது.",
  "helpTopicPhotosStep1": "பகல் வெளிச்சம் பொருளின் மேல் விழக் கதவு அல்லது ஜன்னல் அருகே நில்லுங்கள்",
  "helpTopicPhotosStep2": "சுற்றிலும் வேறு எதுவும் இல்லாமல் பொருளை ஒரு சாதாரணத் துணியின் மேல் வையுங்கள்",
  "helpTopicPhotosStep3": "படம் எடுக்கும் வரை இரண்டு கைகளாலும் போனை அசையாமல் பிடியுங்கள்",
  "helpTopicPhotosStep4": "வேலைப்பாடு தெரிய அருகிலிருந்து ஒன்று எடுங்கள்",
  "helpTopicPhotosStep5": "அளவு தெரிய ஒரு படத்தில் அருகில் கை வையுங்கள்",
  "helpTopicVoice": "உங்கள் பொருளைப் பற்றி என்ன சொல்வது",
  "helpTopicVoiceBody": "எதிரே நிற்கும் வாடிக்கையாளரிடம் பேசுவது போலவே பேசுங்கள். சொல்வதில் தவறான வழி இல்லை.",
  "helpTopicVoiceStep1": "இது என்ன என்று சொல்லுங்கள்",
  "helpTopicVoiceStep2": "இது எதனால் செய்தது என்று சொல்லுங்கள்",
  "helpTopicVoiceStep3": "இது எவ்வளவு பெரியது என்று அங்குலம் அல்லது அடியில் சொல்லுங்கள்",
  "helpTopicVoiceStep4": "செய்ய எவ்வளவு நேரம் ஆனது என்று சொல்லுங்கள்",
  "helpTopicVoiceStep5": "இதற்கு உங்களுக்கு எவ்வளவு வேண்டும் என்று சொல்லுங்கள்",
  "helpTopicPrice": "விலையை நிர்ணயிப்பது",
  "helpTopicPriceBody": "உங்கள் விலையில் மூலப்பொருள் செலவும் உங்கள் நேரத்தின் மதிப்பும் அடங்க வேண்டும். உங்களுடன் சேர்ந்து அதைக் கணக்கிடுகிறோம், சொல்லாமல் அதற்குக் கீழே போக ஒருபோதும் விடமாட்டோம்.",
  "helpTopicPriceStep1": "மூலப்பொருட்களுக்கு எவ்வளவு செலவானது என்று கணக்கிடுங்கள்",
  "helpTopicPriceStep2": "வேலைக்கு எத்தனை நாட்கள் ஆனது என்று கணக்கிடுங்கள்",
  "helpTopicPriceStep3": "நாங்கள் பரிந்துரைப்பதைப் பாருங்கள், உங்களுக்கு நன்றாகத் தெரிந்தால் மாற்றுங்கள்",
  "helpTopicPriceStep4": "உங்கள் செலவைவிடக் குறைவாக இருந்தால் சொல்வோம், ஆனால் முடிவு உங்களுடையது",
  "helpTopicSold": "விற்ற பிறகு என்ன நடக்கும்",
  "helpTopicSoldBody": "வாங்குபவர் சந்தையில் பணம் செலுத்துகிறார். நீங்கள் பேக் செய்து ஒப்படைக்கிறீர்கள், பணம் உங்களுக்கு வருகிறது.",
  "helpTopicSoldStep1": "விற்றவுடன் உங்களுக்குச் சொல்வோம்",
  "helpTopicSoldStep2": "என்ன, எத்தனை பேக் செய்வது என்று திறந்து பாருங்கள்",
  "helpTopicSoldStep3": "நாங்கள் காட்டும் தேதிக்கு முன் பேக் செய்யுங்கள்",
  "helpTopicSoldStep4": "எடுக்க வருபவரிடம் ஒப்படையுங்கள்",
  "helpTopicSoldStep5": "அதன் பிறகு பணம் உங்களை வந்தடையும்",
  "helpVideoComing": "இதற்கான ஒரு சிறிய வீடியோ விரைவில் வருகிறது.",
  "helpPractice": "நல்ல படம் எடுப்பது எப்படி",
  "helpPracticeBody": "ஒரே பானையின் ஒரு நல்ல படமும் ஒரு மோசமான படமும்.",
  "helpFaqEntry": "மக்கள் கேட்கும் கேள்விகள்",
  "helpAboutEntry": "கீர்த்திகர் பற்றி",
  "helpSupportEntry": "ஒருவரிடம் பேசுங்கள்",
  "helpTermsEntry": "விதிமுறைகளும் தனியுரிமையும்",
  "faqTitle": "மக்கள் கேட்கும் கேள்விகள்",
  "faqQ1": "இதற்கு எனக்கு ஏதாவது செலவாகுமா?",
  "faqA1": "இல்லை. பொருட்களை வைப்பது இலவசம். ஏதாவது விற்றால் மட்டுமே சந்தை சிறிய பங்கை எடுக்கும்.",
  "faqQ2": "நெட்வொர்க் இல்லையென்றால்?",
  "faqA2": "எல்லாம் வேலை செய்துகொண்டே இருக்கும். நீங்கள் செய்வது போனில் இருக்கும், நெட்வொர்க் வந்ததும் தானாக அனுப்பப்படும்.",
  "faqQ3": "என் பணம் யாருக்குப் போகும்?",
  "faqA3": "உங்களுக்கு. வாங்குபவர் சந்தையில் பணம் செலுத்துகிறார், அது உங்கள் கணக்குக்கு வருகிறது. பணம் ஒருபோதும் எங்கள் வழியாகப் போகாது.",
  "faqQ4": "விற்பனைக்கு வைத்த பிறகு ஏதாவது மாற்றலாமா?",
  "faqA4": "ஆம். உங்கள் பொருட்களிலிருந்து திறந்து, வேண்டியதை மாற்றுங்கள், அது மீண்டும் விற்பனைக்குப் போகும்.",
  "faqQ5": "நான் ஏதாவது தவறாகச் சொன்னால்?",
  "faqA5": "நீங்கள் கேட்டுச் சரி என்று சொல்லும் வரை எதுவும் விற்பனைக்குப் போகாது. எந்தப் பகுதியையும் பேசித் திருத்தலாம்.",
  "faqQ6": "எனக்குப் படிக்க, எழுதத் தெரிய வேண்டுமா?",
  "faqA6": "இல்லை. எல்லாவற்றையும் பேசியும் அழுத்தியும் செய்யலாம். ஒவ்வொரு திரையையும் உங்களுக்குப் படித்துக் காட்டலாம்.",
  "faqQ7": "என் பெயரையும் ஊரையும் யார் பார்ப்பார்கள்?",
  "faqA7": "நீங்கள் அனுமதித்தால் மட்டுமே, ஒவ்வொரு பொருளுக்கும் தனியாக. எப்போது வேண்டுமானாலும் திரும்பப் பெறலாம்.",
  "aboutTitle": "கீர்த்திகர் பற்றி",
  "aboutWhatTitle": "இது என்ன",
  "aboutWhat": "கீர்த்திகர் கையால் செய்த பொருட்களை ONDC-க்கு, இந்தியாவின் திறந்த வாங்கல்-விற்றல் வலைப்பின்னலுக்கு, கொண்டு சேர்க்கிறது, அதற்குச் செய்பவர் தட்டச்சு செய்யத் தேவையில்லை, பேசினால் போதும். உங்கள் சொந்த மொழியில் சில படங்களும் ஒரு குரல் பதிவும், நாடு முழுவதும் உள்ள வாங்குபவர்கள் கண்டுபிடிக்கக்கூடிய பட்டியலாக மாறுகின்றன.",
  "aboutWhyTitle": "நாங்கள் ஏன் இதை உருவாக்கினோம்",
  "aboutWhy": "இந்தியாவில் சுமார் எழுபது லட்சம் கைவினைஞர்கள் மக்கள் வாங்க விரும்பும் பொருட்களைச் செய்கிறார்கள், அவர்களில் பெரும்பாலோர் வித்தியாசத்தை எடுத்துக்கொள்ளும் இடைத்தரகர் மூலம் விற்கிறார்கள். தடை வேலையில் இல்லை. படிவத்தில் உள்ளது: இணையப் பட்டியல் ஆங்கிலத் தட்டச்சு, பல கட்டங்கள், அட்டவணைப் படம் போன்றவற்றைக் கேட்கிறது. இந்தச் செயலி அந்தப் படிவத்தையே நீக்குகிறது.",
  "aboutHowTitle": "இது எப்படி வேலை செய்கிறது",
  "aboutHow": "மூன்று படங்கள் எடுத்து இது என்ன என்று சொல்லுங்கள். எங்கள் அமைப்பு கேட்கிறது, பட்டியலை எழுதுகிறது, உங்களுக்குப் படித்துக் காட்டுகிறது. நீங்கள் கேட்டுச் சரி என்று சொல்லும் வரை எதுவும் வெளியே போகாது.",
  "aboutSihTitle": "ஸ்மார்ட் இந்தியா ஹேக்கத்தான் 2025",
